import numpy as np
import onnxruntime as ort

class SileroVAD:
    def __init__(self, model_path="silero_vad.onnx", sample_rate=16000):
        self.sample_rate = sample_rate
        # 1. Initialize ONNX Runtime Session
        opts = ort.SessionOptions()
        opts.inter_op_num_threads = 1
        opts.intra_op_num_threads = 1
        self.session = ort.InferenceSession(model_path, opts)

        # 2. Initialize Silero VAD Recurrent Neural Network (RNN) States
        self._h = np.zeros((2, 1, 64), dtype=np.float32)
        self._c = np.zeros((2, 1, 64), dtype=np.float32)
        self._sr = np.array(self.sample_rate, dtype=np.int64)

    def reset_states(self):
        """Reset internal hidden states between separate audio streams."""
        self._h = np.zeros((2, 1, 64), dtype=np.float32)
        self._c = np.zeros((2, 1, 64), dtype=np.float32)

    def get_speech_probability(self, audio_chunk_float32: np.ndarray) -> float:
        """
        Processes a 512-sample chunk of 16kHz float32 audio (-1.0 to 1.0).
        Returns a float score between 0.0 (Silence) and 1.0 (Speech).
        """
        # Ensure input chunk is 2D batch tensor shape [1, N]
        if audio_chunk_float32.ndim == 1:
            input_tensor = np.expand_dims(audio_chunk_float32, axis=0)
        else:
            input_tensor = audio_chunk_float32

        # 3. Pass inputs to the ONNX model
        inputs = {
            "input": input_tensor.astype(np.float32),
            "sr": self._sr,
            "h": self._h,
            "c": self._c
        }

        # 4. Run inference
        out, self._h, self._c = self.session.run(None, inputs)
        
        # Output probability score
        return float(out[0][0])


# ==========================================
# EXAMPLE USAGE WITH LIVE WEBSOCKET / CHUNKS
# ==========================================
if __name__ == "__main__":
    # Load the VAD Engine
    vad = SileroVAD("silero_vad.onnx")

    # Silero requires chunk size of exactly 512 samples for 16kHz audio
    CHUNK_SIZE = 512 

    # Simulated incoming 16kHz PCM Float32 audio chunk
    dummy_audio_chunk = np.random.uniform(-0.1, 0.1, CHUNK_SIZE).astype(np.float32)

    # Get speech score
    speech_probability = vad.get_speech_probability(dummy_audio_chunk)
    
    print(f"Speech Probability: {speech_probability:.4f}")
    if speech_probability > 0.5:
        print("🎤 Voice Detected!")
    else:
        print("🤫 Silence")
